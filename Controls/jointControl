    def auto_fill_geometry(self):
        prev_type = "none"

        for i, row in enumerate(self.config_rows):
            curr_type = row["type_box"].currentText()

            if i < 2:
                if curr_type != "none":
                    prev_type = curr_type
                self.update_config_row_state(i)
                continue

            a_val, d_val, alpha_val, theta_offset_val = auto_geom_from_types(prev_type, curr_type)

            if curr_type == "none":
                row["a_edit"].setText("0.000")
                row["d_edit"].setText("0.000")
                row["alpha_edit"].setText(self.format_angle(0.0))
                row["theta_offset_edit"].setText(self.format_angle(0.0))
            else:
                row["a_edit"].setText(f"{a_val:.3f}")
                row["d_edit"].setText(f"{d_val:.3f}")
                row["alpha_edit"].setText(self.format_angle(alpha_val))
                row["theta_offset_edit"].setText(self.format_angle(theta_offset_val))
                prev_type = curr_type

            self.update_config_row_state(i)

    def on_type_changed(self, idx):
        row = self.config_rows[idx]
        mtype = row["type_box"].currentText()

        if idx >= 2:
            if mtype == "none":
                row["qmin_edit"].setText(self.format_angle(0.0))
                row["qmax_edit"].setText(self.format_angle(0.0))
                row["home_edit"].setText(self.format_angle(0.0))
            else:
                meta = MODULE_TYPES[mtype]
                row["qmin_edit"].setText(self.format_angle(meta["default_limits"][0]))
                row["qmax_edit"].setText(self.format_angle(meta["default_limits"][1]))
                row["home_edit"].setText(self.format_angle(0.0))

        self.update_config_row_state(idx)
        self.auto_fill_geometry()

    def update_config_row_state(self, idx):
        row = self.config_rows[idx]
        is_none = (row["type_box"].currentText() == "none")
        row["qmin_edit"].setEnabled(not is_none)
        row["qmax_edit"].setEnabled(not is_none)
        row["home_edit"].setEnabled(not is_none)

    def refresh_config_angle_fields(self):
        for i, m in enumerate(self.modules):
            row = self.config_rows[i]
            row["alpha_edit"].setText(self.format_angle(m["alpha"]))
            row["theta_offset_edit"].setText(self.format_angle(m["theta_offset"]))

            if not m["fixed"]:
                row["qmin_edit"].setText(self.format_angle(m["qlim"][0]))
                row["qmax_edit"].setText(self.format_angle(m["qlim"][1]))
                row["home_edit"].setText(self.format_angle(m["home_q"]))

    def change_angle(self, idx, delta_rad):
        m = self.modules[idx]
        if m["fixed"] or m["type"] == "none":
            return
        qmin, qmax = m["qlim"]
        m["q"] = max(qmin, min(qmax, round(m["q"] + delta_rad, 6)))
        self.refresh_control_row(idx)
        self.plot_data()

    def refresh_control_row(self, idx):
        m = self.modules[idx]
        row = self.control_rows[idx]
        row["type_lbl"].setText(m["type"])

        if m["fixed"]:
            row["angle_lbl"].setText("fixed")
            servo_deg = joint_to_servo_deg(m["name"], m["q"])
            row["aux_lbl"].setText("-" if servo_deg is None else f'{servo_deg:.1f}')
            row["down_btn"].setEnabled(False)
            row["up_btn"].setEnabled(False)
            row["name_lbl"].setStyleSheet("")
            row["type_lbl"].setStyleSheet("")
            row["angle_lbl"].setStyleSheet("")
        elif m["type"] == "none":
            row["angle_lbl"].setText("unused")
            row["aux_lbl"].setText("-")
            row["down_btn"].setEnabled(False)
            row["up_btn"].setEnabled(False)
            row["name_lbl"].setStyleSheet("color: gray;")
            row["type_lbl"].setStyleSheet("color: gray;")
            row["angle_lbl"].setStyleSheet("color: gray;")
        else:
            row["angle_lbl"].setText(f'{self.angle_to_display(m["q"]):.2f}')
            servo_deg = joint_to_servo_deg(m["name"], m["q"])
            row["aux_lbl"].setText("-" if servo_deg is None else f'{servo_deg:.1f}')
            row["down_btn"].setEnabled(True)
            row["up_btn"].setEnabled(True)
            row["name_lbl"].setStyleSheet("")
            row["type_lbl"].setStyleSheet("")
            row["angle_lbl"].setStyleSheet("")

    def refresh_all_control_rows(self):
        for i in range(len(self.modules)):
            self.refresh_control_row(i)

    def apply_geometry(self):
        try:
            for i, m in enumerate(self.modules):
                row = self.config_rows[i]
                mtype = row["type_box"].currentText()
                meta = MODULE_TYPES[mtype]

                m["type"] = mtype
                m["joint_kind"] = meta["joint_kind"]
                m["a"] = float(row["a_edit"].text())
                m["d"] = float(row["d_edit"].text())
                m["z_world"] = float(row["z_world_edit"].text())
                m["alpha"] = self.angle_from_display(float(row["alpha_edit"].text()))
                m["theta_offset"] = self.angle_from_display(float(row["theta_offset_edit"].text()))

                if m["type"] == "none":
                    m["q"] = 0.0
                    m["home_q"] = 0.0
                    m["qlim"] = (0.0, 0.0)
                elif not m["fixed"]:
                    qmin = self.angle_from_display(float(row["qmin_edit"].text()))
                    qmax = self.angle_from_display(float(row["qmax_edit"].text()))
                    home_q = self.angle_from_display(float(row["home_edit"].text()))

                    if qmin > qmax:
                        qmin, qmax = qmax, qmin

                    m["qlim"] = (qmin, qmax)
                    m["home_q"] = max(qmin, min(qmax, home_q))
                    m["q"] = max(qmin, min(qmax, m["q"]))

            self.refresh_all_control_rows()
            self.refresh_config_angle_fields()
            self.plot_data()
        except Exception as e:
            print("Apply geometry error:", e)

    def go_home(self):
        for m in self.modules:
            if not m["fixed"] and m["type"] != "none":
                qmin, qmax = m["qlim"]
                m["q"] = max(qmin, min(qmax, m["home_q"]))
        self.refresh_all_control_rows()
        self.plot_data()

    def reset_angles(self):
        for m in self.modules:
            if not m["fixed"] and m["type"] != "none":
                m["q"] = 0.0
        self.refresh_all_control_rows()
        self.plot_data()

    def send(self):
        try:
            values = []
            for m in self.modules:
                if m["fixed"] or m["type"] == "none":
                    continue

                servo_deg = joint_to_servo_deg(m["name"], m["q"])
                if servo_deg is not None:
                    values.append(servo_deg)

            data = ",".join(f"{v:.1f}" for v in values)
            print("SEND:", data)
        except Exception as e:
            print("Send error:", e)

    def plot_data(self):
        try:
            X, Y, Z, pts, point_names = forward_kin(self.modules)

            if hasattr(self.window, "ax"):
                self.window.ax.cla()
                self.window.ax.plot(X, Y, Z, 'b-o', linewidth=2, markersize=5, label='Arm')
                self.window.ax.scatter([X[-1]], [Y[-1]], [Z[-1]], c='r', s=90, label='End-effector')

                for i, (x, y, z) in enumerate(pts):
                    self.window.ax.text(x, y, z + 0.05, point_names[i], fontsize=9, color='black')

                self.window.ax.set_xlabel('X (m)')
                self.window.ax.set_ylabel('Y (m)')
                self.window.ax.set_zlabel('Z (m)')
                self.window.ax.set_xlim([-4, 4])
                self.window.ax.set_ylim([-4, 4])
                self.window.ax.set_zlim([0, 5])
                self.window.ax.legend()
                self.window.fig.canvas.draw()

                self.posLbl.setText(
                    f'End-effector: X={X[-1]:.3f}, Y={Y[-1]:.3f}, Z={Z[-1]:.3f}'
                )
        except Exception as e:
            print("Plot error:", e)

