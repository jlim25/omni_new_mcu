def build_modules(config):
    modules = []
    for item in config:
        meta = MODULE_TYPES[item["type"]]
        modules.append({
            "name": item["name"],
            "type": item["type"],
            "joint_kind": meta["joint_kind"],
            "alpha": float(item.get("alpha", meta["alpha"])),
            "theta_offset": float(item.get("theta_offset", meta["theta_offset"])),
            "a": float(item.get("a", 0.0)),
            "d": float(item.get("d", 0.0)),
            "z_world": float(item.get("z_world", 0.0)),
            "q": float(item.get("q", 0.0)),
            "home_q": float(item.get("home_q", 0.0)),
            "qlim": tuple(item.get("qlim", meta["default_limits"])),
            "fixed": bool(item.get("fixed", False)),
        })
    return modules

def clamp(x, lo, hi):
    return max(lo, min(hi, x))

def map_range(x, in_min, in_max, out_min, out_max):
    if abs(in_max - in_min) < 1e-9:
        return out_min
    return out_min + (x - in_min) * (out_max - out_min) / (in_max - in_min)

def joint_to_servo_deg(joint_name, joint_rad):
    if joint_name not in SERVO_CAL:
        return None
    c = SERVO_CAL[joint_name]
    joint_deg = math.degrees(joint_rad)
    if c.get("invert", False):
        joint_deg = -joint_deg
    servo_deg = map_range(
        joint_deg,
        c["joint_min"], c["joint_max"],
        c["servo_min"], c["servo_max"]
    )
    return clamp(servo_deg, c["servo_min"], c["servo_max"])

def joint_axis_family(joint_type):
    if joint_type == "swivel":
        return "swivel"
    if joint_type == "rotation":
        return "rotation"
    return "none"

def auto_geom_from_types(prev_type, curr_type):
    if curr_type == "none":
        return 0.0, 0.0, 0.0, 0.0

    if prev_type == "none":
        if curr_type == "swivel":
            return 0.0, 1.0, 0.0, 0.0
        if curr_type == "rotation":
            return 0.0, 1.0, -math.pi / 2, 0.0

    if prev_type == "swivel" and curr_type == "swivel":
        return 0.0, 1.0, 0.0, 0.0

    if prev_type == "swivel" and curr_type == "rotation":
        return 0.0, 1.0, -math.pi / 2, 0.0

    if prev_type == "rotation" and curr_type == "rotation":
        return 1.0, 0.0, 0.0, 0.0

    if prev_type == "rotation" and curr_type == "swivel":
        return 0.0, 1.0, -math.pi / 2, 0.0

    return 0.0, 1.0, 0.0, 0.0

def pose(theta, alpha, a, d):
    c, s = math.cos(theta), math.sin(theta)
    ca, sa = math.cos(alpha), math.sin(alpha)
    return np.array([
        [c,    -s,    0.0,  a],
        [s*ca,  c*ca, -sa,  -d*sa],
        [s*sa,  c*sa,  ca,   d*ca],
        [0.0,   0.0,  0.0,  1.0]
    ], dtype=float)

def forward_kin(modules):
    T = np.eye(4)
    pts = [(0.0, 0.0, 0.0)]
    point_names = ["BASE"]

    for m in modules:
        if m["type"] == "none":
            continue

        theta = m["theta_offset"] + (0.0 if m["fixed"] else m["q"])
        T = T @ pose(theta, m["alpha"], m["a"], m["d"])
        T[2, 3] += m["z_world"]

        pts.append((float(T[0, 3]), float(T[1, 3]), float(T[2, 3])))
        point_names.append(m["name"])

    X = np.array([p[0] for p in pts], dtype=float)
    Y = np.array([p[1] for p in pts], dtype=float)
    Z = np.array([p[2] for p in pts], dtype=float)
    return X, Y, Z, pts, point_names

def create_plot():
    fig = plt.figure(figsize=(7, 5))
    ax = fig.add_subplot(111, projection='3d')
    ax.set_xlabel('X (m)')
    ax.set_ylabel('Y (m)')
    ax.set_zlabel('Z (m)')
    ax.set_xlim([-4, 4])
    ax.set_ylim([-4, 4])
    ax.set_zlim([0, 5])
    ax.set_autoscale_on(False)
    return fig, ax

class MainWindow(QtWidgets.QMainWindow):
    def __init__(self):
        super().__init__()
        self.fig, self.ax = create_plot()
        plt.ion()

