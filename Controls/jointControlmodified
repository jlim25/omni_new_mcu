            elif row["kind"] == "link":
                m = self.modules[row["module_index"]]
                row["link_box"].setCurrentText(nearest_link_preset_text(float(np.linalg.norm(m["link"]))))

    def refresh_config_fields(self):
        for i, m in enumerate(self.modules):
            row = self.config_rows[i]
            row["type_box"].setCurrentText(m["type"])
            row["axis_box"].setCurrentText(m["axis"])
            row["ox"].setText(str(m["offset"][0]))
            row["oy"].setText(str(m["offset"][1]))
            row["oz"].setText(str(m["offset"][2]))
            row["lx"].setText(str(m["link"][0]))
            row["ly"].setText(str(m["link"][1]))
            row["lz"].setText(str(m["link"][2]))
            if not m["fixed"]:
                row["qmin_edit"].setText(self.format_angle(m["qlim"][0]))
                row["qmax_edit"].setText(self.format_angle(m["qlim"][1]))
                row["home_edit"].setText(self.format_angle(m["home_q"]))

    def apply_structure(self):
        try:
            for row in self.structure_rows:
                if row["kind"] == "joint":
                    m = self.modules[row["module_index"]]
                    if m["fixed"]:
                        continue

                    new_type = row["type_box"].currentText()
                    m["type"] = new_type

                    if new_type == "none":
                        m["q"] = 0.0
                        m["home_q"] = 0.0
                        m["qlim"] = (0.0, 0.0)
                    else:
                        meta = JOINT_TYPES[new_type]
                        if m["qlim"] == (0.0, 0.0):
                            m["qlim"] = meta["default_limits"]

                        if m["name"] == "J1":
                            m["axis"] = "z"
                        elif new_type == "rotation":
                            m["axis"] = "y"
                        elif new_type == "swivel":
                            m["axis"] = "z"

                elif row["kind"] == "link":
                    m = self.modules[row["module_index"]]
                    selected = row["link_box"].currentText()
                    link_len = LINK_PRESETS_M[selected]

                    old_norm = float(np.linalg.norm(m["link"]))
                    if old_norm < 1e-9:
                        m["link"] = np.array([0.0, 0.0, link_len], dtype=float)
                    else:
                        m["link"] = (m["link"] / old_norm) * link_len

            self.refresh_all_control_rows()
            self.refresh_structure_fields()
            self.refresh_config_fields()
            self.plot_data()

        except Exception as e:
            print("Apply structure error:", e)

    def change_angle(self, idx, delta_rad):
        m = self.modules[idx]
        if m["fixed"] or m["type"] == "none":
            return
        qmin, qmax = m["qlim"]
        m["q"] = max(qmin, min(qmax, round(m["q"] + delta_rad, 6)))
        self.refresh_control_row(idx)
        self.plot_data()

    def refresh_control_row(self, idx):
        m = self.modules[idx]
        row = self.control_rows[idx]
        row["type_lbl"].setText(m["type"])
        row["axis_lbl"].setText(m["axis"].upper())

        if m["fixed"]:
            row["angle_lbl"].setText("fixed")
            servo_deg = joint_to_servo_deg(m["name"], m["q"])
            row["aux_lbl"].setText("-" if servo_deg is None else f"{servo_deg:.1f}")
            row["down_btn"].setEnabled(False)
            row["up_btn"].setEnabled(False)
        elif m["type"] == "none":
            row["angle_lbl"].setText("unused")
            row["aux_lbl"].setText("-")
            row["down_btn"].setEnabled(False)
            row["up_btn"].setEnabled(False)
        else:
            row["angle_lbl"].setText(f"{self.angle_to_display(m['q']):.2f}")
            servo_deg = joint_to_servo_deg(m["name"], m["q"])
            row["aux_lbl"].setText("-" if servo_deg is None else f"{servo_deg:.1f}")
            row["down_btn"].setEnabled(True)
            row["up_btn"].setEnabled(True)

    def refresh_all_control_rows(self):
        for i in range(len(self.modules)):
            self.refresh_control_row(i)

    def apply_geometry(self):
        try:
            for i, m in enumerate(self.modules):
                row = self.config_rows[i]
                mtype = row["type_box"].currentText()
                m["type"] = mtype
                m["axis"] = row["axis_box"].currentText()
                m["offset"] = np.array([
                    float(row["ox"].text()),
                    float(row["oy"].text()),
                    float(row["oz"].text())
                ], dtype=float)
                m["link"] = np.array([
                    float(row["lx"].text()),
                    float(row["ly"].text()),
                    float(row["lz"].text())
                ], dtype=float)

                if m["type"] == "none":
                    m["q"] = 0.0
                    m["home_q"] = 0.0
                    m["qlim"] = (0.0, 0.0)
                elif not m["fixed"]:
                    qmin = self.angle_from_display(float(row["qmin_edit"].text()))
                    qmax = self.angle_from_display(float(row["qmax_edit"].text()))
                    home_q = self.angle_from_display(float(row["home_edit"].text()))
                    if qmin > qmax:
                        qmin, qmax = qmax, qmin
                    m["qlim"] = (qmin, qmax)
                    m["home_q"] = max(qmin, min(qmax, home_q))
                    m["q"] = max(qmin, min(qmax, m["q"]))

            self.refresh_all_control_rows()
            self.refresh_structure_fields()
            self.refresh_config_fields()
            self.plot_data()
        except Exception as e:
            print("Apply geometry error:", e)

    def go_home(self):
        for m in self.modules:
            if not m["fixed"] and m["type"] != "none":
                qmin, qmax = m["qlim"]
                m["q"] = max(qmin, min(qmax, m["home_q"]))
        self.refresh_all_control_rows()
        self.plot_data()

    def reset_angles(self):
        for m in self.modules:
            if not m["fixed"] and m["type"] != "none":
                m["q"] = 0.0
        self.refresh_all_control_rows()
        self.plot_data()

    def send(self):
        try:
            values = []
            for m in self.modules:
                if m["fixed"] or m["type"] == "none":
                    continue
                servo_deg = joint_to_servo_deg(m["name"], m["q"])
                if servo_deg is not None:
                    values.append(servo_deg)
            data = ",".join(f"{v:.1f}" for v in values)
            print("SEND:", data)
        except Exception as e:
            print("Send error:", e)

    def plot_data(self):
        try:
            X, Y, Z, pts, point_names, frames = forward_kin(self.modules)

            if hasattr(self.window, "ax"):
                self.window.ax.cla()
                style_3d_axes(self.window.ax, show_plot_axes=self.show_plot_axes)

                if self.preview_mode == "3D Model":
                    draw_robot_model(self.window.ax, pts, frames)
                    self.window.ax.scatter([X[-1]], [Y[-1]], [Z[-1]], c='#f87171', s=50)
                else:
                    self.window.ax.plot(X, Y, Z, color='#60a5fa', marker='o', linewidth=2.5, markersize=5, label='Arm')
                    self.window.ax.scatter([X[-1]], [Y[-1]], [Z[-1]], c='#f87171', s=90, label='End-effector')
                    draw_frame_axes(self.window.ax, frames, show_axes_frames=self.show_frame_axes)

                if self.preview_mode == "Skeleton":
                    for i, (x, y, z) in enumerate(pts):
                        self.window.ax.text(x, y, z + 0.02, point_names[i], fontsize=9, color='#e5e7eb')
                else:
                    self.window.ax.text(pts[0][0], pts[0][1], pts[0][2] + 0.03, "BASE", fontsize=9, color='#e5e7eb')
                    self.window.ax.text(pts[-1][0], pts[-1][1], pts[-1][2] + 0.03, "GRIP", fontsize=9, color='#e5e7eb')

                auto_fit_axes_cube(self.window.ax, X, Y, Z, scale=1.5, min_cube=0.4)
                self.window.ax.view_init(elev=22, azim=-58)

                if self.preview_mode == "Skeleton":
                    leg = self.window.ax.legend(facecolor="#111827", edgecolor="#475569")
                    for txt in leg.get_texts():
                        txt.set_color("#e5e7eb")

                self.window.fig.tight_layout()
                self.window.canvas.draw()

                self.posLbl.setText(f"End-effector: X={X[-1]:.3f}, Y={Y[-1]:.3f}, Z={Z[-1]:.3f}")
        except Exception as e:
            print("Plot error:", e)


