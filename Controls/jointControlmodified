def auto_fit_axes_cube(ax, X, Y, Z, scale=1.5, min_cube=0.4):
    x_min, x_max = float(np.min(X)), float(np.max(X))
    y_min, y_max = float(np.min(Y)), float(np.max(Y))
    z_min, z_max = float(np.min(Z)), float(np.max(Z))

    x_mid = 0.5 * (x_min + x_max)
    y_mid = 0.5 * (y_min + y_max)
    z_mid = 0.5 * (z_min + z_max)

    dx = x_max - x_min
    dy = y_max - y_min
    dz = z_max - z_min

    span = max(dx, dy, dz, min_cube)
    cube_side = span * scale
    half = 0.5 * cube_side

    z_low = z_mid - half
    z_high = z_mid + half

    if z_low < 0.0:
        z_high += -z_low
        z_low = 0.0

    ax.set_xlim([x_mid - half, x_mid + half])
    ax.set_ylim([y_mid - half, y_mid + half])
    ax.set_zlim([z_low, z_high])
    ax.set_box_aspect((1, 1, 1))


def forward_kin(modules):
    T = np.eye(4)

    chain_pts = [np.array([0.0, 0.0, 0.0], dtype=float)]
    joint_pts = [(0.0, 0.0, 0.0)]
    point_names = ["BASE"]

    frames = [{
        "name": "BASE",
        "origin": np.array([0.0, 0.0, 0.0], dtype=float),
        "x_axis": np.array([1.0, 0.0, 0.0], dtype=float),
        "y_axis": np.array([0.0, 1.0, 0.0], dtype=float),
        "z_axis": np.array([0.0, 0.0, 1.0], dtype=float),
    }]

    for m in modules:
        T = T @ Tx(*m["offset"])

        joint_origin = T[:3, 3].copy()
        R_before = T[:3, :3].copy()

        joint_pts.append((float(joint_origin[0]), float(joint_origin[1]), float(joint_origin[2])))
        point_names.append(m["name"])
        frames.append({
            "name": m["name"],
            "origin": joint_origin,
            "x_axis": R_before[:, 0].copy(),
            "y_axis": R_before[:, 1].copy(),
            "z_axis": R_before[:, 2].copy(),
        })

        q = 0.0 if m["fixed"] or m["type"] == "none" else m["q"]
        T = T @ rot_from_axis(m["axis"], q)
        T = T @ Tx(*m["link"])

        link_end = T[:3, 3].copy()
        chain_pts.append(link_end)

    X = np.array([p[0] for p in chain_pts], dtype=float)
    Y = np.array([p[1] for p in chain_pts], dtype=float)
    Z = np.array([p[2] for p in chain_pts], dtype=float)
    return X, Y, Z, joint_pts, point_names, frames


def unit_vector(v):
    n = np.linalg.norm(v)
    if n < 1e-9:
        return np.array([0.0, 0.0, 1.0], dtype=float)
    return v / n


def orthonormal_basis_from_z(direction):
    z_axis = unit_vector(direction)
    helper = np.array([0.0, 0.0, 1.0], dtype=float)
    if abs(np.dot(z_axis, helper)) > 0.95:
        helper = np.array([0.0, 1.0, 0.0], dtype=float)

    x_axis = np.cross(helper, z_axis)
    x_axis = unit_vector(x_axis)
    y_axis = np.cross(z_axis, x_axis)
    y_axis = unit_vector(y_axis)
    return x_axis, y_axis, z_axis


def draw_cylinder(ax, p0, p1, radius=0.018, color="#b8c2cc", edgecolor="#7c8794", alpha=1.0, n_theta=24):
    p0 = np.array(p0, dtype=float)
    p1 = np.array(p1, dtype=float)
    axis = p1 - p0
    length = np.linalg.norm(axis)
    if length < 1e-9:
        return

    ex, ey, ez = orthonormal_basis_from_z(axis)

    theta = np.linspace(0, 2 * np.pi, n_theta)
    t = np.linspace(0, length, 2)
    theta_grid, t_grid = np.meshgrid(theta, t)

    X = p0[0] + ez[0] * t_grid + radius * np.cos(theta_grid) * ex[0] + radius * np.sin(theta_grid) * ey[0]
    Y = p0[1] + ez[1] * t_grid + radius * np.cos(theta_grid) * ex[1] + radius * np.sin(theta_grid) * ey[1]
    Z = p0[2] + ez[2] * t_grid + radius * np.cos(theta_grid) * ex[2] + radius * np.sin(theta_grid) * ey[2]

    ax.plot_surface(X, Y, Z, color=color, linewidth=0.12, edgecolor=edgecolor, shade=True, alpha=alpha, antialiased=False)

    r = np.linspace(0, radius, 12)
    theta2 = np.linspace(0, 2 * np.pi, n_theta)
    rr, tt = np.meshgrid(r, theta2)

    cap0x = p0[0] + rr * np.cos(tt) * ex[0] + rr * np.sin(tt) * ey[0]
    cap0y = p0[1] + rr * np.cos(tt) * ex[1] + rr * np.sin(tt) * ey[1]
    cap0z = p0[2] + rr * np.cos(tt) * ex[2] + rr * np.sin(tt) * ey[2]

    cap1x = p1[0] + rr * np.cos(tt) * ex[0] + rr * np.sin(tt) * ey[0]
    cap1y = p1[1] + rr * np.cos(tt) * ex[1] + rr * np.sin(tt) * ey[1]
    cap1z = p1[2] + rr * np.cos(tt) * ex[2] + rr * np.sin(tt) * ey[2]

    ax.plot_surface(cap0x, cap0y, cap0z, color=color, linewidth=0, shade=True, alpha=alpha, antialiased=False)
    ax.plot_surface(cap1x, cap1y, cap1z, color=color, linewidth=0, shade=True, alpha=alpha, antialiased=False)


def draw_box_centered(ax, center, size, color="#cfd4da", edgecolor="#6b7280", alpha=1.0):
    cx, cy, cz = center
    sx, sy, sz = size
    ax.bar3d(
        [cx - sx / 2], [cy - sy / 2], [cz - sz / 2],
        [sx], [sy], [sz],
        color=color, edgecolor=edgecolor, shade=True, alpha=alpha
    )


def draw_joint_box(ax, center, main_size=(0.050, 0.038, 0.062), accent_scale=1.0, is_base=False):
    cx, cy, cz = center

    body_color = "#d9dee4"
    edge_color = "#7c8794"
    bracket_color = "#2b313a"
    cap_color = "#111827"
    face_color = "#aab4bf"

    sx, sy, sz = main_size
    sx *= accent_scale
    sy *= accent_scale
    sz *= accent_scale

    draw_box_centered(ax, (cx, cy, cz), (sx, sy, sz), color=body_color, edgecolor=edge_color, alpha=1.0)

    plate_t = sy * 0.38
    plate_w = sx * 0.42
    plate_h = sz * 0.58
    side_offset = sy * 0.52

    draw_box_centered(ax, (cx, cy - side_offset, cz - sz * 0.08), (plate_w, plate_t, plate_h),
                      color=bracket_color, edgecolor="#111827", alpha=1.0)
    draw_box_centered(ax, (cx, cy + side_offset, cz - sz * 0.08), (plate_w, plate_t, plate_h),
                      color=bracket_color, edgecolor="#111827", alpha=1.0)

    cap_r = min(sx, sz) * 0.16
    p0 = np.array([cx, cy - sy * 0.70, cz], dtype=float)
    p1 = np.array([cx, cy + sy * 0.70, cz], dtype=float)
    draw_cylinder(ax, p0, p1, radius=cap_r, color=cap_color, edgecolor="#0b0f19", alpha=1.0, n_theta=20)

    draw_box_centered(ax, (cx, cy, cz + sz * 0.34), (sx * 0.72, sy * 0.80, sz * 0.10),
                      color=face_color, edgecolor=edge_color, alpha=0.95)

    if is_base:
        draw_box_centered(ax, (cx, cy, cz - sz * 0.60), (sx * 1.45, sy * 1.45, sz * 0.35),
                          color="#8f99a6", edgecolor="#6b7280", alpha=1.0)


def draw_servo_head(ax, center, radius=0.010, color="#111827"):
    center = np.array(center, dtype=float)
    p0 = center + np.array([0.0, -0.016, 0.0])
    p1 = center + np.array([0.0,  0.016, 0.0])
    draw_cylinder(ax, p0, p1, radius=radius, color=color, edgecolor="#020617", alpha=1.0, n_theta=22)


def draw_robot_model(ax, joint_pts, frames):
    steel_color = "#c7d0d9"
    steel_edge = "#8b98a8"
    tube_dark = "#95a3b3"

    origins = [np.array(p, dtype=float) for p in joint_pts]

    if len(origins) >= 2:
        for i in range(len(origins) - 1):
            p0 = origins[i]
            p1 = origins[i + 1]
            seg = p1 - p0
            seg_len = np.linalg.norm(seg)
            if seg_len < 1e-9:
                continue

            u = seg / seg_len
            joint_clear = min(0.030, seg_len * 0.18)
            a = p0 + u * joint_clear
            b = p1 - u * joint_clear

            if np.linalg.norm(b - a) > 1e-9:
                draw_cylinder(ax, a, b, radius=0.0105, color=steel_color, edgecolor=steel_edge, alpha=1.0, n_theta=24)

                mid = 0.5 * (a + b)
                sleeve_half = min(0.022, 0.18 * np.linalg.norm(b - a))
                s0 = mid - u * sleeve_half
                s1 = mid + u * sleeve_half
                draw_cylinder(ax, s0, s1, radius=0.0135, color=tube_dark, edgecolor="#6b7280", alpha=1.0, n_theta=22)

    for idx, f in enumerate(frames[1:]):
        origin = f["origin"]
        scale = 1.18 if idx == 0 else 1.0
        draw_joint_box(ax, origin, main_size=(0.050, 0.038, 0.062), accent_scale=scale, is_base=False)
        draw_servo_head(ax, origin, radius=0.0088)

    base = frames[0]["origin"]
    draw_joint_box(ax, base + np.array([0.0, 0.0, 0.020]), main_size=(0.058, 0.050, 0.050), accent_scale=1.18, is_base=True)


def create_plot():
    fig = plt.figure(figsize=(7.5, 6.5), facecolor="#0f172a")
    ax = fig.add_subplot(111, projection='3d')
    return fig, ax


def style_3d_axes(ax, show_plot_axes=True):
    bg = "#0b1220"
    pane = (0.11, 0.16, 0.25, 1.0)
    grid = (0.55, 0.65, 0.78, 0.18)
    text = "#e5e7eb"
    line = (0.65, 0.75, 0.85, 0.55)

    ax.set_facecolor(bg)
    ax.set_xlabel("X (m)", color=text)
    ax.set_ylabel("Y (m)", color=text)
    ax.set_zlabel("Z (m)", color=text)
    ax.tick_params(colors=text, grid_color=grid, grid_alpha=0.35)

    try:
        ax.xaxis.set_pane_color(pane)
        ax.yaxis.set_pane_color(pane)
        ax.zaxis.set_pane_color(pane)
    except Exception:
        pass

    try:
        ax.xaxis.line.set_color(line)
        ax.yaxis.line.set_color(line)
        ax.zaxis.line.set_color(line)
    except Exception:
        pass

    ax.grid(show_plot_axes, color=grid, linestyle='-', linewidth=0.6)

    if show_plot_axes:
        ax.set_axis_on()
    else:
        ax.set_axis_off()


def draw_frame_axes(ax, frames, show_axes_frames=True, axis_len=0.04):
    if not show_axes_frames:
        return

    try:
        xs = [f["origin"][0] for f in frames]
        ys = [f["origin"][1] for f in frames]
        zs = [f["origin"][2] for f in frames]
        span = max(max(xs) - min(xs), max(ys) - min(ys), max(zs) - min(zs), 0.2)
        axis_len = max(0.03, span * 0.08)
    except Exception:
        axis_len = 0.05

    for f in frames:
        o = f["origin"]
        x = f["x_axis"]
        y = f["y_axis"]
        z = f["z_axis"]

        ax.quiver(o[0], o[1], o[2], x[0], x[1], x[2], length=axis_len, normalize=True, color='#ef4444')
        ax.quiver(o[0], o[1], o[2], y[0], y[1], y[2], length=axis_len, normalize=True, color='#22c55e')
        ax.quiver(o[0], o[1], o[2], z[0], z[1], z[2], length=axis_len, normalize=True, color='#3b82f6')


